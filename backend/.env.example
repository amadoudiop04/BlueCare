# Copier en `.env` et ajuster. Ne jamais committer le `.env`.

NODE_ENV=development
PORT=3000

# Origine autorisee pour CORS (le serveur de dev Vite)
CORS_ORIGIN=http://localhost:5173

# Format des logs morgan : dev | combined | tiny
LOG_FORMAT=dev

# --- Authentification (JWT) --------------------------------------------------
# OBLIGATOIRES en production : le serveur refuse de demarrer sans elles.
# Generer une valeur solide : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Secret distinct : un refresh token ne doit jamais passer pour un access token.
JWT_REFRESH_SECRET=

# Durees de validite (format `ms` : 15m, 24h, 30d...)
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=30d
# Duree d'un lien de suivi envoye a une famille
FAMILY_LINK_TTL=7d

# Cout du hachage bcrypt et longueur minimale des mots de passe
BCRYPT_ROUNDS=10
MIN_PASSWORD_LENGTH=10

# --- Alertes d'absences repetees ---------------------------------------------
# Jours d'accueil consecutifs manques avant de declencher une alerte.
ATTENDANCE_CONSECUTIVE_THRESHOLD=3
# Largeur de la fenetre glissante d'observation, en jours.
ATTENDANCE_WINDOW_DAYS=30
# Absences NON justifiees tolerees sur cette fenetre avant alerte.
ATTENDANCE_WINDOW_THRESHOLD=4

# --- Suivi pedagogique et notifications --------------------------------------
# Profondeur des courbes d'evolution, en mois.
PROGRESS_WINDOW_MONTHS=6
# Delai avant qu'un compte-rendu manquant soit signale en retard, en jours.
REPORT_DUE_DAYS=2
# Horizon des rappels de seances planifiees, en jours.
SESSION_REMINDER_DAYS=2

# --- Galerie anonymisee ------------------------------------------------------
# Sel des alias de la galerie. A definir une fois pour toutes en production :
# le modifier renomme tous les alias deja affiches. A garder secret.
ANONYMIZATION_SALT=bluecare-dev-salt

# --- Supabase ----------------------------------------------------------------
# Non utilisees tant que la couche `models/` est en memoire (voir README).
# Le schema SQL cible est dans backend/supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Jeu de donnees de demonstration au demarrage (ignore si NODE_ENV=production).
SEED_DEMO_DATA=true
