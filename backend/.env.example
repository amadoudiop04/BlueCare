# Copier en `.env` et ajuster. Ne jamais committer le `.env`.

NODE_ENV=development
PORT=3000

# Origine autorisee pour CORS (le serveur de dev Vite)
CORS_ORIGIN=http://localhost:5173

# Format des logs morgan : dev | combined | tiny
LOG_FORMAT=dev

# --- Authentification --------------------------------------------------------
# Les sessions de connexion vivent en base : elles ne dependent d'aucun secret.
# JWT_SECRET ne signe plus que deux jetons sans etat, le lien de suivi famille
# et le defi de double authentification.
#
# OBLIGATOIRE en production : le serveur refuse de demarrer sans lui.
# Generer une valeur solide : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duree d'un lien de suivi envoye a une famille (format `ms` : 15m, 24h, 30d...)
FAMILY_LINK_TTL=7d

# Cout du hachage bcrypt et longueur minimale des mots de passe
BCRYPT_ROUNDS=10
MIN_PASSWORD_LENGTH=10

# --- Mot de passe oublie -----------------------------------------------------
# Adresse publique du front : les liens de reinitialisation sont construits
# a partir d'elle. En production, mettre l'URL reelle du site.
APP_URL=http://localhost:5173

# Duree de validite d'un lien de reinitialisation, en minutes.
PASSWORD_RESET_TTL_MINUTES=60

# Aucun fournisseur de courriel n'est branche : en developpement le lien est
# ecrit dans les logs du serveur. En production, brancher un vrai transport
# dans backend/src/utils/mailer.js, sinon la demande echoue franchement.

# --- Alertes d'absences repetees ---------------------------------------------
# Jours d'accueil consecutifs manques avant de declencher une alerte.
ATTENDANCE_CONSECUTIVE_THRESHOLD=3
# Largeur de la fenetre glissante d'observation, en jours.
ATTENDANCE_WINDOW_DAYS=30
# Absences NON justifiees tolerees sur cette fenetre avant alerte.
ATTENDANCE_WINDOW_THRESHOLD=4

# --- Suivi pedagogique et notifications --------------------------------------
# Profondeur des courbes d'evolution, en mois.
PROGRESS_WINDOW_MONTHS=6
# Delai avant qu'un compte-rendu manquant soit signale en retard, en jours.
REPORT_DUE_DAYS=2
# Horizon des rappels de seances planifiees, en jours.
SESSION_REMINDER_DAYS=2

# --- Galerie anonymisee ------------------------------------------------------
# Sel des alias de la galerie. A definir une fois pour toutes en production :
# le modifier renomme tous les alias deja affiches. A garder secret.
ANONYMIZATION_SALT=bluecare-dev-salt

# --- Supabase ----------------------------------------------------------------
# CE FICHIER EST VERSIONNE : n'y mettre aucune valeur reelle. Les vraies clefs
# vont dans `backend/.env`, qui est ignore par git.
#
# Renseigner l'URL et la clef secrete bascule TOUT le stockage sur Postgres.
# Les laisser vides garde le stockage en memoire (donnees perdues au redemarrage).
#
# Dashboard Supabase > Project Settings > API Keys :
#   SUPABASE_URL              = Project URL
#   SUPABASE_SECRET_KEY       = clef secrete `sb_secret_...`
#   SUPABASE_PUBLISHABLE_KEY  = clef publique `sb_publishable_...` (facultative ici)
#
# La clef secrete contourne toutes les policies RLS : elle donne les pleins
# pouvoirs sur les dossiers des enfants. Jamais dans le navigateur, jamais dans
# une variable prefixee VITE_, jamais dans un fichier suivi par git.
#
# Les projets plus anciens exposent les memes clefs sous les noms
# SUPABASE_SERVICE_ROLE_KEY et SUPABASE_ANON_KEY : les deux nomenclatures sont
# acceptees.
#
# Avant le premier lancement : executer backend/supabase/schema.sql dans le
# SQL Editor, puis `npm run seed --workspace backend`.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Amorcage des donnees de demonstration au demarrage. Ne s'applique qu'au
# stockage en memoire : avec Supabase, l'amorcage est explicite (`npm run seed`).
SEED_DEMO_DATA=true

# Mot de passe commun aux six comptes de demonstration. Aucune valeur par
# defaut : un identifiant en clair dans le depot finit toujours par etre essaye
# ailleurs. Laisse vide, l'amorcage en tire un au hasard et l'affiche une seule
# fois dans la console — le renseigner ici evite d'aller le relire a chaque
# redemarrage. Ce fichier-ci est un exemple : la valeur va dans `.env`.
SEED_PASSWORD=






